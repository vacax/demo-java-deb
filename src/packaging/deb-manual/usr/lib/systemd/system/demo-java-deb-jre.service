[Unit]
Description=Demo Java Deb - servicio HTTP de ejemplo (JRE del sistema)
Documentation=https://github.com/vacax/demo-java-deb
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/demo-java-deb-jre
EnvironmentFile=-/etc/default/demo-java-deb-jre
User=demo-java-deb-jre
Group=demo-java-deb-jre
StateDirectory=demo-java-deb-jre
Restart=on-failure
RestartSec=3
# La JVM termina con 128+15=143 al recibir SIGTERM: no es un fallo
SuccessExitStatus=143
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
